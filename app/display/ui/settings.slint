// Port of ui/src/display/SettingsPage.tsx: the settings view (button C).

import { Palette, Label } from "theme.slint";

export component SettingsPage {
    // The theme was picked here (0 dark, 1 light, 2 night), for saving
    callback theme-selected(int);
    width: 320px;
    height: 240px;

    property <length> gap: 8px;
    property <length> option-w: (300px - 2 * self.gap) / 3;

    Label {
        x: 10px;
        y: 31px;
        text: "THEME";
    }

    // Large touch targets; the active one filled like the nav
    for name[i] in ["DARK", "LIGHT", "NIGHT"]: Rectangle {
        x: 10px + i * (root.option-w + root.gap);
        y: 50px;
        width: root.option-w;
        height: 44px;
        background: i == Palette.theme ? Palette.track : transparent;
        border-width: i == Palette.theme ? 0 : 1px;
        border-color: Palette.edge;

        Text {
            text: name;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.65px;
            color: i == Palette.theme ? Palette.ink : Palette.dim;
        }

        TouchArea {
            clicked => {
                Palette.theme = i;
                root.theme-selected(i);
            }
        }
    }
}
