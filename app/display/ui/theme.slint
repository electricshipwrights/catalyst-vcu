// Inter with tabular digits as the default (Slint can't switch on OpenType
// features), and its Display cut for the large SOC numbers. See app/README.md.
import "../fonts/Inter-Regular.ttf";
import "../fonts/Inter-Medium.ttf";
import "../fonts/Inter-SemiBold.ttf";
import "../fonts/Inter-Bold.ttf";
import "../fonts/Inter-DisplaySemiBold.ttf";

// Colors from ui/src/display/display.css. theme: 0 dark, 1 light, 2 night.
// One bright and one dim text color, grays for lines and surfaces, and color
// only in the bars.
export global Palette {
    in-out property <int> theme: 0;
    out property <color> bg: theme == 1 ? #f5f5f3 : theme == 2 ? #000000 : #131417;
    out property <color> track: theme == 1 ? #e0e0e2 : theme == 2 ? #1c0504 : #24262b;
    out property <color> ink: theme == 1 ? #0b0b0c : theme == 2 ? #ff4433 : #f5f5f6;
    out property <color> dim: theme == 1 ? #6b6c70 : theme == 2 ? #ff4433 : #8a8d94;
    // Low-contrast border on the empty part of the tracks
    out property <color> edge: theme == 1 ? #c6c7ca : theme == 2 ? #5c1610 : #3a3d43;
    out property <color> solar: theme == 1 ? #e0a100 : theme == 2 ? #ff4433 : #e9a13b;
    out property <color> load: theme == 1 ? #2b2d31 : theme == 2 ? #d93a2b : #a98bff;
    out property <color> house: theme == 1 ? #a4a7ad : theme == 2 ? #9a2a1d : #5d4c8f;
}

export global Fonts {
    out property <string> text: "Inter";
    out property <string> display: "Inter Display";
}

// Static labels: small, letter-spaced, dimmed so the numbers lead
export component Label inherits Text {
    font-family: Fonts.text;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    color: Palette.dim;
}
