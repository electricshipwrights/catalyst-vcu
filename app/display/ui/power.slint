// Port of ui/src/display/PowerPage.tsx. Positions are the prototype's CSS
// pixels. Text y values are CSS line-box tops adjusted for Inter's metrics
// (a Slint Text box is the font's ascent + descent, 1.21 em).

import { Palette, Prefs, Fonts, Label } from "theme.slint";

// One battery side, as computed by vcu_core::power_view.
export struct SideView {
    online: bool,
    soc: int,
    shore: bool,
    solar-a: int,
    // MPPTs 1–4: amps, or −1 when not allocated to this side
    mppt-a: [float],
    // Shore charging; −1 when the charger is silent (no shore power)
    charger-a: int,
    in-a: int,
    out-a: int,
    // The house load from the inside out, then the motor
    base-a: int,
    heater-a: int,
    inverter-a: int,
    propulsion-a: int,
    net-a: int,
    // 0 none, 1 full, 2 pending (still settling), 3 time, 4 reserve (discharging below 9%)
    eta-kind: int,
    eta-time: string,
    eta-to-full: bool,
}

global Scale {
    out property <length> track-w: 124px;
    out property <length> port-x: 10px;
    out property <length> stbd-x: 186px;
    out property <length> input-y: 148px;
    out property <length> load-y: 170px;

    // Input per source: shore at the inner end, then MPPT 1–4, each on its
    // own scale (the Elcon's 80 A; about 34 A per MPPT at full sun)
    out property <length> slot-gap: 4px;
    out property <length> slot-w: (self.track-w - 4 * self.slot-gap) / 5;
    out property <float> shore-slot-a: 80;
    out property <float> solar-slot-a: 35;

    // Slot n from the inner end, in the same place on both sides
    public pure function slot-x(port: bool, n: int) -> length {
        return port ? self.port-x + self.track-w - self.slot-w - n * (self.slot-w + self.slot-gap)
            : self.stbd-x + n * (self.slot-w + self.slot-gap);
    }

    // Amps to pixels along a track whose full scale is `full`
    public pure function px(amps: int, full: float) -> length {
        return max(0, min(amps, full)) / full * self.track-w;
    }

    // "+12", "−7" or "0"
    public pure function signed(n: int) -> string {
        return n > 0 ? "+" + n : n < 0 ? "−" + (-n) : "0";
    }
}

// A bar of up to four parts (amps) stacked from the inner end; port bars grow
// leftward. A 1px gap where one part meets the next. A low-contrast 1px
// border inside the track, under the bars, shows only where it's empty.
component Track {
    in property <bool> port;
    in property <[int]> parts;
    in property <[color]> colors;
    // Amps at the far end of the track
    in property <float> full-scale;
    width: Scale.track-w;
    height: 12px;

    Rectangle {
        background: Palette.track;
        clip: true;

        Rectangle {
            border-width: 1px;
            border-color: Palette.edge;
        }

        for a[i] in root.parts: Rectangle {
            property <int> from: i == 0 ? 0 : i == 1 ? root.parts[0] : i == 2 ? root.parts[0] + root.parts[1] : root.parts[0] + root.parts[1] + root.parts[2];
            property <length> offset: Scale.px(self.from, root.full-scale) + (self.from > 0 ? 1px : 0);
            y: 0;
            width: max(0px, Scale.px(self.from + a, root.full-scale) - self.offset);
            height: parent.height;
            x: root.port ? parent.width - self.offset - self.width : self.offset;
            background: root.colors[i];
        }
    }
}

// A 1px dashed outline, like CSS's `1px dashed`: 3px dashes, 3px apart
component Dashed {
    in property <color> color;
    property <int> across: ceil(self.width / 6px);
    property <int> down: ceil(self.height / 6px);

    for i in root.across: Rectangle {
        x: i * 6px;
        y: 0;
        width: min(3px, root.width - self.x);
        height: 1px;
        background: root.color;
    }

    for i in root.across: Rectangle {
        x: i * 6px;
        y: root.height - 1px;
        width: min(3px, root.width - self.x);
        height: 1px;
        background: root.color;
    }

    for i in root.down: Rectangle {
        x: 0;
        y: i * 6px;
        width: 1px;
        height: min(3px, root.height - self.y);
        background: root.color;
    }

    for i in root.down: Rectangle {
        x: root.width - 1px;
        y: i * 6px;
        width: 1px;
        height: min(3px, root.height - self.y);
        background: root.color;
    }
}

// Icons, scaled from the prototype's SVGs. Paths wind counter-clockwise:
// Slint's FemtoVG renderer (not used now) draws clockwise outlines too large.
export component ShoreIcon inherits Path {
    height: 15px;
    width: self.height * 9 / 11;
    viewbox-width: 9;
    viewbox-height: 11;
    commands: "M2 0 V3 H0 V5.5 C0 7.2 1.2 8.4 2.8 8.6 V11 H6.2 V8.6 C7.8 8.4 9 7.2 9 5.5 V3 H7 V0 H5.8 V3 H3.2 V0 Z";
    fill: Palette.ink;
}

component ChargingIcon inherits Path {
    height: 18px;
    width: self.height * 9 / 13;
    viewbox-width: 9;
    viewbox-height: 13;
    commands: "M5.5 0 L0 7.5 H4 L3 13 L9 5 H5 Z";
    fill: Palette.ink;
}

component DischargingIcon inherits Path {
    height: 18px;
    width: self.height * 10 / 12;
    viewbox-width: 10;
    viewbox-height: 12;
    commands: "M3.5 0 V6.5 H0 L5 12 L10 6.5 H6.5 V0 Z";
    fill: Palette.ink;
}

// SOC with the charging/discharging icon, then the plug when on shore power,
// on the inboard side. Positioned at the top of the 47px CSS line box.
component Soc {
    in property <bool> port;
    in property <SideView> view;
    property <color> ink: root.view.online ? Palette.ink : Palette.dim;
    property <bool> flow: root.view.online && root.view.net-a != 0;
    property <bool> charging: root.view.net-a > 0;
    property <length> flow-w: root.charging ? 18px * 9 / 13 : 15px;
    property <bool> shore: root.view.online && root.view.shore;

    // The number and "%" share a baseline 40.6px below the line-box top
    number := Text {
        x: root.port ? 0 : pct.x - 1px - self.width;
        y: -5px;
        text: root.view.online ? root.view.soc : "--";
        font-family: Fonts.display;
        font-size: 47px;
        font-weight: 600;
        letter-spacing: -0.47px;
        color: root.ink;
    }

    pct := Text {
        x: root.port ? number.width + 1px : root.width - self.width;
        y: 26px;
        text: "%";
        font-size: 15px;
        font-weight: 500;
        color: root.ink;
    }

    property <length> flow-x: root.port ? pct.x + pct.width + 8px : number.x - 8px - root.flow-w;
    ChargingIcon {
        visible: root.flow && root.charging;
        x: root.flow-x;
        y: 15px;
    }

    DischargingIcon {
        visible: root.flow && !root.charging;
        x: root.flow-x;
        y: 15px;
    }

    if root.shore: ShoreIcon {
        x: root.port ? (root.flow ? root.flow-x + root.flow-w : pct.x + pct.width) + 8px : (root.flow ? root.flow-x : number.x) - 8px - self.width;
        y: 17px;
    }
}

// Input per source: a slot for shore under a plug, then one per MPPT,
// numbered above. In use on this side: a track filled on that source's own
// scale. Allocated elsewhere, unplugged or no data: a dashed outline.
component InputSlots {
    in property <bool> port;
    in property <SideView> view;
    // Laid out on the whole page, like the tracks
    width: 320px;
    height: 240px;

    for n in 5: slot := Rectangle {
        property <float> a: !root.view.online ? -1 : n == 0 ? root.view.charger-a : root.view.mppt-a[n - 1];
        property <float> full: n == 0 ? Scale.shore-slot-a : Scale.solar-slot-a;
        property <bool> away: self.a < 0;
        property <length> fill: self.away ? 0 : min(self.a, self.full) / self.full * Scale.slot-w;
        property <color> label-color: self.away ? Palette.edge : Palette.dim;
        x: Scale.slot-x(root.port, n);
        y: Scale.input-y - 14px;
        width: Scale.slot-w;
        height: 26px;

        if n == 0: ShoreIcon {
            x: (parent.width - self.width) / 2;
            y: 2px;
            height: 9px;
            fill: slot.label-color;
        }

        if n > 0: Label {
            x: 0;
            y: 0;
            width: parent.width;
            horizontal-alignment: center;
            text: n;
            color: slot.label-color;
        }

        if slot.away: Dashed {
            y: 14px;
            width: slot.width;
            height: 12px;
            color: Palette.edge;
        }

        if !slot.away: Rectangle {
            y: 14px;
            height: 12px;
            background: Palette.track;
            clip: true;

            Rectangle {
                border-width: 1px;
                border-color: Palette.edge;
            }

            Rectangle {
                x: root.port ? parent.width - self.width : 0;
                width: slot.fill;
                background: n == 0 ? Palette.shore : Palette.solar;
            }
        }
    }
}

// "4:00 to empty" under the SOC: the time stands out, the rest is quieter
component Eta {
    in property <bool> port;
    in property <SideView> view;
    property <string> to: root.view.eta-to-full ? " to full" : " to empty";
    property <string> time: !root.view.online || root.view.eta-kind == 0 ? "--"
        : root.view.eta-kind == 1 ? "full"
        : root.view.eta-kind == 4 ? "reserve"
        : root.view.eta-kind == 2 ? "--"
        : root.view.eta-time;
    property <string> rest: root.view.online && (root.view.eta-kind == 2 || root.view.eta-kind == 3) ? root.to : "";

    time-text := Text {
        x: root.port ? 0 : rest-text.x - self.width;
        y: 0;
        text: root.time;
        font-size: 13px;
        font-weight: 600;
        color: Palette.ink;
    }

    rest-text := Text {
        x: root.port ? time-text.width : root.width - self.width;
        y: 0;
        text: root.rest;
        font-size: 13px;
        color: Palette.dim;
    }
}

// Net current with in (solar + charger) and out beside it on the inboard side,
// signed so they need no labels. Positioned at the top of the CSS footer box.
component Footer {
    in property <bool> port;
    in property <SideView> view;

    net := Text {
        x: root.port ? 0 : root.width - self.width;
        y: -1px;
        text: root.view.online ? Scale.signed(root.view.net-a) + " A" : "NO DATA";
        font-size: 16px;
        font-weight: 700;
        color: root.view.online ? Palette.ink : Palette.dim;
    }

    // Online: in then out; offline: "BMS silent"
    in-text := Text {
        x: root.port ? net.width + 12px : net.x - 12px - (root.view.online ? out-text.width + 8px : 0) - self.width;
        y: root.view.online ? 2px : 3px;
        text: root.view.online ? Scale.signed(root.view.in-a) : "BMS silent";
        font-size: 11px;
        color: Palette.dim;
    }

    out-text := Text {
        x: root.port ? net.width + 12px + in-text.width + 8px : net.x - 12px - self.width;
        y: 2px;
        text: root.view.online ? Scale.signed(-root.view.out-a) : "";
        font-size: 11px;
        color: Palette.dim;
    }
}

export component PowerPage {
    in property <SideView> port;
    in property <SideView> stbd;
    // The load bar's full scale (vcu_core::AutoScale)
    in property <int> scale-max: 100;
    // The scale the bars are drawn at: eased to a new one, so they grow or
    // shrink smoothly instead of jumping; the labels change at once
    property <float> shown-scale: root.scale-max;
    animate shown-scale {
        duration: 500ms;
        // Ease-out cubic, like the prototype
        easing: cubic-bezier(0.33, 1, 0.68, 1);
    }
    property <bool> combined: Prefs.input == 1;
    width: 320px;
    height: 240px;

    Label {
        x: 10px;
        y: 31px;
        text: "PORT";
    }

    Label {
        x: 310px - self.width;
        y: 31px;
        text: "STBD";
    }

    Soc {
        x: 10px;
        y: 46px;
        width: 145px;
        height: 47px;
        port: true;
        view: root.port;
    }

    Soc {
        x: 165px;
        y: 46px;
        width: 145px;
        height: 47px;
        port: false;
        view: root.stbd;
    }

    Eta {
        x: 10px;
        y: 99px;
        width: 145px;
        height: 16px;
        port: true;
        view: root.port;
    }

    Eta {
        x: 165px;
        y: 99px;
        width: 145px;
        height: 16px;
        port: false;
        view: root.stbd;
    }

    // Input: per source, or combined (shore, then solar) on the load scale
    // with its axis above the track
    if !root.combined: InputSlots {
        port: true;
        view: root.port;
    }

    if !root.combined: InputSlots {
        port: false;
        view: root.stbd;
    }

    if root.combined: Track {
        x: Scale.port-x;
        y: Scale.input-y;
        port: true;
        parts: root.port.online ? [max(0, root.port.charger-a), root.port.solar-a] : [];
        colors: [Palette.shore, Palette.solar];
        full-scale: root.shown-scale;
    }

    if root.combined: Track {
        x: Scale.stbd-x;
        y: Scale.input-y;
        parts: root.stbd.online ? [max(0, root.stbd.charger-a), root.stbd.solar-a] : [];
        colors: [Palette.shore, Palette.solar];
        full-scale: root.shown-scale;
    }

    for end[i] in [root.scale-max, 0, 0, root.scale-max]: Label {
        visible: root.combined;
        x: i < 2 ? Scale.port-x + (i == 0 ? 0 : Scale.track-w - self.width) : Scale.stbd-x + (i == 2 ? 0 : Scale.track-w - self.width);
        y: Scale.input-y - 14px;
        text: end;
    }

    // Load: the house (base, heater, inverter) stays put at the inner end;
    // the motor, which swings with the throttle, goes outermost
    Track {
        x: Scale.port-x;
        y: Scale.load-y;
        port: true;
        parts: root.port.online ? [root.port.base-a, root.port.heater-a, root.port.inverter-a, root.port.propulsion-a] : [];
        colors: [Palette.base, Palette.heater, Palette.inverter, Palette.load];
        full-scale: root.shown-scale;
    }

    Track {
        x: Scale.stbd-x;
        y: Scale.load-y;
        parts: root.stbd.online ? [root.stbd.base-a, root.stbd.heater-a, root.stbd.inverter-a, root.stbd.propulsion-a] : [];
        colors: [Palette.base, Palette.heater, Palette.inverter, Palette.load];
        full-scale: root.shown-scale;
    }

    // Row labels, centered between the tracks
    for label[i] in ["INPUT", "LOAD"]: Label {
        x: 160px - self.width / 2;
        y: (i == 0 ? Scale.input-y : Scale.load-y);
        text: label;
    }

    // Scale ends only: full scale at the outer end of each track, 0 at the
    // inner end
    Label {
        x: Scale.port-x;
        y: 186px;
        text: root.scale-max;
    }

    Label {
        x: Scale.port-x + Scale.track-w - self.width;
        y: 186px;
        text: "0";
    }

    Label {
        x: Scale.stbd-x;
        y: 186px;
        text: "0";
    }

    Label {
        x: Scale.stbd-x + Scale.track-w - self.width;
        y: 186px;
        text: root.scale-max;
    }

    Footer {
        x: 10px;
        y: 213px;
        width: 145px;
        height: 18px;
        port: true;
        view: root.port;
    }

    Footer {
        x: 165px;
        y: 213px;
        width: 145px;
        height: 18px;
        port: false;
        view: root.stbd;
    }
}
