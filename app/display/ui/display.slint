// Port of ui/src/display/Display.tsx: 320×240 screen, one view per hardware
// button (A, B, C), with their labels in a bar along the top. The board is
// mounted upside down, so the buttons sit above the screen.

import { Palette, Fonts, Label } from "theme.slint";
import { PowerPage, SideView } from "power.slint";

export { Palette, SideView }

export component Display inherits Window {
    width: 320px;
    height: 240px;
    background: Palette.bg;
    default-font-family: Fonts.text;

    in property <SideView> port;
    in property <SideView> stbd;
    in-out property <int> page: 0;

    property <[string]> titles: ["POWER", "VIEW 2", "VIEW 3"];
    property <length> bar-height: 21px;

    // Button A, B or C (0–2), from the hardware buttons or the bench
    public function select(button: int) {
        root.page = max(0, min(root.titles.length - 1, button));
    }

    swipe := SwipeGestureHandler {
        y: root.bar-height + 1px;
        height: root.height - self.y;
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => {
            let dx = self.current-position.x - self.pressed-position.x;
            if abs(dx) > 30px {
                root.select(root.page + (dx < 0 ? 1 : -1));
            }
        }

        if root.page > 0: Label {
            text: "tbd";
        }
    }

    // The power page is laid out on the whole screen, like the prototype
    if root.page == 0: PowerPage {
        port: root.port;
        stbd: root.stbd;
    }

    // Top bar: each label sits under its button, centered in its third; the
    // active view's third is filled, like a segmented control
    for title[i] in root.titles: Rectangle {
        x: i * root.width / 3;
        y: 0;
        width: root.width / 3;
        height: root.bar-height;
        background: i == root.page ? Palette.track : transparent;

        Label {
            text: title;
            color: i == root.page ? Palette.ink : Palette.dim;
        }

        TouchArea {
            clicked => {
                root.select(i);
            }
        }
    }

    Rectangle {
        y: root.bar-height;
        height: 1px;
        background: Palette.track;
    }
}
