import "../fonts/BarlowSemiCondensed-Regular.ttf";
import "../fonts/BarlowSemiCondensed-SemiBold.ttf";
import "../fonts/BarlowSemiCondensed-Bold.ttf";

export struct BusInfo {
    name: string,
    state: string,
    fps: int,
    last: string,
    has-pack: bool,
    soc: float,
    volts: float,
    amps: float,
}

export global Palette {
    in-out property <int> theme: 0;
    out property <string> theme-name: theme == 1 ? "LIGHT" : theme == 2 ? "NIGHT" : "DARK";
    out property <color> bg: theme == 1 ? #f5f5f3 : theme == 2 ? #000000 : #131417;
    out property <color> ink: theme == 1 ? #0b0b0c : theme == 2 ? #ff4433 : #f5f5f6;
    out property <color> ink-2: theme == 1 ? #3f4044 : theme == 2 ? #a8291e : #a0a3aa;
    out property <color> muted: theme == 1 ? #9a9a9e : theme == 2 ? #5c1610 : #5f626a;
    out property <color> rule: theme == 1 ? #c6c6ca : theme == 2 ? #3d0d09 : #2f3238;
    out property <color> solar: theme == 1 ? #f07800 : theme == 2 ? #ff4433 : #e9a13b;
    out property <color> load: theme == 1 ? #6a3bd8 : theme == 2 ? #9e2419 : #a98bff;
}

component Caption inherits Text {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.7px;
    color: Palette.ink-2;
}

component Rule inherits Rectangle {
    x: 10px;
    height: 1px;
    background: Palette.rule;
}

component BusRow {
    in property <BusInfo> bus;
    height: 30px;

    Text {
        x: 0;
        y: 0;
        text: bus.name + " · " + bus.state + (bus.state == "up" ? " · " + bus.fps + " fps" : "");
        font-size: 11px;
        font-weight: 600;
        color: bus.state == "up" ? Palette.ink : Palette.muted;
    }

    Text {
        x: parent.width - self.width;
        y: 0;
        visible: bus.has-pack;
        text: bus.soc.to-fixed(1) + "% · " + bus.volts.to-fixed(1) + " V · " + (bus.amps < 0 ? "−" : "") + abs(bus.amps).to-fixed(1) + " A";
        font-size: 11px;
        font-weight: 600;
        color: Palette.ink;
    }

    Text {
        x: 0;
        y: 14px;
        text: bus.last == "" ? "no frames" : bus.last;
        font-size: 10px;
        color: Palette.ink-2;
        letter-spacing: 0.3px;
    }
}

export component Spike inherits Window {
    width: 320px;
    height: 240px;
    background: Palette.bg;
    default-font-family: "Barlow Semi Condensed";

    in property <string> clock: "--:--:--";
    in property <BusInfo> can0: { name: "can0", state: "?" };
    in property <BusInfo> can1: { name: "can1", state: "?" };
    in property <string> raw-touch: "";
    in property <string> stats: "";
    in property <string> display-info: "";

    property <int> taps: 0;
    property <length> touch-x: -1px;
    property <length> touch-y: -1px;
    property <string> last-swipe: "none";

    swipe := SwipeGestureHandler {
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => {
            root.last-swipe = self.current-position.x < self.pressed-position.x ? "left" : "right";
        }

        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.taps += 1;
                    root.touch-x = self.mouse-x;
                    root.touch-y = self.mouse-y;
                }
            }
            moved => {
                root.touch-x = self.mouse-x;
                root.touch-y = self.mouse-y;
            }
        }
    }

    // Header
    Text {
        x: 10px;
        y: 0;
        height: 21px;
        vertical-alignment: center;
        text: "BOARD CHECK";
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.4px;
        color: Palette.ink;
    }

    Text {
        x: parent.width - self.width - 10px;
        y: 0;
        height: 21px;
        vertical-alignment: center;
        text: root.clock;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.6px;
        color: Palette.ink-2;
    }

    Rectangle {
        y: 21px;
        height: 1px;
        background: Palette.rule;
    }

    // Touch
    Caption {
        x: 10px;
        y: 30px;
        text: "TOUCH";
    }

    Text {
        x: 10px;
        y: 42px;
        text: root.taps + " taps · at " + round(root.touch-x / 1px) + ", " + round(root.touch-y / 1px);
        font-size: 11px;
        color: Palette.ink;
    }

    Text {
        x: 10px;
        y: 56px;
        text: "raw " + (root.raw-touch == "" ? "–" : root.raw-touch) + " · swipe " + (swipe.swiping ? "…" : root.last-swipe);
        font-size: 11px;
        color: Palette.ink-2;
    }

    // Big number, to check large glyphs
    Text {
        x: parent.width - self.width - 10px;
        y: 26px;
        text: root.can0.has-pack ? round(root.can0.soc) : "--";
        font-size: 44px;
        font-weight: 600;
        color: root.can0.has-pack ? Palette.ink : Palette.muted;
    }

    Rule {
        y: 78px;
        width: parent.width - 20px;
    }

    // CAN
    Caption {
        x: 10px;
        y: 84px;
        text: "CAN";
    }

    BusRow {
        x: 10px;
        y: 96px;
        width: parent.width - 20px;
        bus: root.can0;
    }

    BusRow {
        x: 10px;
        y: 128px;
        width: parent.width - 20px;
        bus: root.can1;
    }

    Rule {
        y: 162px;
        width: parent.width - 20px;
    }

    // Controls and icons
    theme-button := Rectangle {
        x: 10px;
        y: 176px;
        width: 92px;
        height: 30px;
        border-width: 1px;
        border-color: theme-ta.pressed ? Palette.ink : Palette.rule;
        background: theme-ta.pressed ? Palette.rule : transparent;

        Text {
            text: "THEME · " + Palette.theme-name;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: Palette.ink;
        }

        theme-ta := TouchArea {
            clicked => {
                Palette.theme = mod(Palette.theme + 1, 3);
            }
        }
    }

    // Charging bolt and shore plug, same paths as the prototype's SVGs
    Path {
        x: 116px;
        y: 184px;
        width: 9px;
        height: 13px;
        viewbox-width: 9;
        viewbox-height: 13;
        commands: "M5.5 0 L0 7.5 H4 L3 13 L9 5 H5 Z";
        fill: Palette.solar;
    }

    Path {
        x: 132px;
        y: 185px;
        width: 9px;
        height: 11px;
        viewbox-width: 9;
        viewbox-height: 11;
        commands: "M2 0 H3.2 V3 H5.8 V0 H7 V3 H9 V5.5 C9 7.2 7.8 8.4 6.2 8.6 V11 H2.8 V8.6 C1.2 8.4 0 7.2 0 5.5 V3 H2 Z";
        fill: Palette.ink;
    }

    Rectangle {
        x: 150px;
        y: 186px;
        width: 30px;
        height: 10px;
        background: Palette.load;
    }

    Text {
        x: parent.width - self.width - 10px;
        y: 176px;
        horizontal-alignment: right;
        text: root.stats;
        font-size: 10px;
        color: Palette.ink-2;
    }

    Text {
        x: parent.width - self.width - 10px;
        y: 190px;
        horizontal-alignment: right;
        text: root.display-info;
        font-size: 10px;
        color: Palette.ink-2;
    }

    Text {
        x: 10px;
        y: 218px;
        text: "Tap anywhere · swipe left or right · tap THEME";
        font-size: 10px;
        color: Palette.muted;
    }

    // Crosshair at the last touch
    if root.touch-x >= 0 : Rectangle {
        x: root.touch-x;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Palette.solar;
    }
    if root.touch-y >= 0 : Rectangle {
        x: 0;
        y: root.touch-y;
        width: parent.width;
        height: 1px;
        background: Palette.solar;
    }
}
