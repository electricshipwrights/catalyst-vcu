{
  "name": "vcu-display",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bus,web -c blue,magenta \"pnpm bus\" \"vite\"",
    "bus": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "parity": "tsx scripts/parity.ts",
    "build:wasm": "cd ../app && PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --release -p vcu-web --target wasm32-unknown-unknown && PATH=\"$HOME/.cargo/bin:$PATH\" wasm-bindgen --target web --out-dir ../ui/src/slint/pkg target/wasm32-unknown-unknown/release/vcu_web.wasm"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
